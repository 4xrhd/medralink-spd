# ==============================================================================
# MedraLink EMR Platform - Unified Environment Configuration
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=50

# Database Configuration
# Option A: PostgreSQL (Recommended for Production / Cloud / Docker)
DB_DIALECT=postgres
DATABASE_URL=postgresql://medra_user:medra_secure_password_2026@localhost:5432/medralink
DATABASE_SSL=false
DB_POOL_MAX=20

# Option B: Embedded SQLite (Zero-config local development and testing)
# DB_DIALECT=sqlite
# SQLITE_PATH=./data/medralink.sqlite

# Initial Provisioning
AUTO_SEED=true

# Frontend Configuration (Optional: only needed if frontend is hosted on separate domain)
# VITE_API_URL=https://api.medralink.example.com/api/v1
