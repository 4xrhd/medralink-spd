# ==============================================================================
# MedraLink EMR Platform - Backend Server Environment Variables
# ==============================================================================

PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Policy (comma-separated origins or *)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=50

# Database Engine Selection ('postgres' | 'sqlite')
DB_DIALECT=postgres
# Local Postgres:
DATABASE_URL=postgresql://medra_user:change_me@localhost:5432/medralink
DATABASE_SSL=false
# Supabase (project svieyxgbzrriwvxosbdw): use the IPv4 Session pooler string from
# Dashboard > Connect, e.g.
# DATABASE_URL=postgresql://postgres.svieyxgbzrriwvxosbdw:<DB_PASSWORD>@<pooler-host>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
DB_POOL_MAX=20

# For SQLite
# DB_DIALECT=sqlite
# SQLITE_PATH=./data/medralink.sqlite

# Auto-seeding on fresh database startup
AUTO_SEED=true
